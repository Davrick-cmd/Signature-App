# ---- SignFlow configuration ----
# Copy to .env (Docker) or server/.env (running Node directly). Never commit the real file.

APP_NAME=SignFlow
# Public URL people open in the browser; used for CORS and links in emails
APP_URL=http://localhost:3001
PORT=3001
# Set to 1 when running behind a reverse proxy or load balancer (Render, Nginx, etc.)
TRUST_PROXY=

# Database (MySQL 8+). Either DATABASE_URL, e.g.
#   mysql://user:pass@host:3306/signflow?ssl-mode=REQUIRED
# or the separate DB_* values below.
DATABASE_URL=
# true = connect over TLS; DB_SSL_CA = the provider's CA certificate (PEM) to verify it
DB_SSL=
DB_SSL_CA=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=signflow
DB_USER=signflow
DB_PASSWORD=change-me

# Session signing key: generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Sign-in methods, tried in order: local, ldap, or local,ldap
AUTH_PROVIDERS=local
# Active Directory / LDAP (only when AUTH_PROVIDERS includes ldap)
LDAP_URL=ldaps://dc.example.com
LDAP_DOMAIN=example.com
LDAP_BASE_DN=
# Domain added to bare usernames (jdoe -> jdoe@example.com)
EMAIL_DOMAIN=example.com
# Comma-separated emails that are always admins
ADMIN_EMAILS=

# First admin for a fresh install (local sign-in). Only used if no admin exists yet.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
# Set to true for one deploy to reset that admin's password to BOOTSTRAP_ADMIN_PASSWORD, then remove it
BOOTSTRAP_ADMIN_RESET=

# Outgoing email. Leave SMTP_HOST empty to print emails to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SignFlow <no-reply@example.com>

# Largest accepted upload. Files are stored in the database.
MAX_UPLOAD_MB=10
